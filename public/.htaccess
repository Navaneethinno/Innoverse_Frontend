# Caching for the admin portal on Apache (copied into dist/ by Vite).
# index.html names the current build's files, so browsers must check it on
# every visit; the files under assets/ have a hash in their name and never
# change, so they can be kept for a year. Needs mod_headers and
# "AllowOverride FileInfo" (or All) for this folder.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
