# Caching for the admin portal on Apache (copied into dist/ by Vite).
# index.html names the current build's files, so browsers must check it on
# every visit; the files under assets/ have a hash in their name and never
# change, so they can be kept for a year. Needs mod_headers and
# "AllowOverride FileInfo" (or All) for this folder.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# Security headers (PCI SSS web; the page's own Content-Security-Policy is a
# <meta> tag written at build time by vite.config.js). A <meta> policy cannot
# stop other sites from framing the admin portal, so frame-ancestors is sent here.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), fullscreen=(self)"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  <If "%{HTTPS} == 'on'">
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  </If>
</IfModule>
